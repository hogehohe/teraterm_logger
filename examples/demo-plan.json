      "expect": "(?m)^mock-device# $",
      "timeoutSeconds": 10
    },
    {
      "id": 3,
      "label": "Demo step 3: hand back after this command",
      "command": "echo DEMO_STEP_3",
      "expect": "(?m)^mock-device# $",
      "timeoutSeconds": 10
    },
    {
      "id": 4,
      "label": "Demo step 4: outside a requested 2-to-3 range",
      "command": "echo DEMO_STEP_4",
      "expect": "(?m)^mock-device# $",
      "timeoutSeconds": 10
    }
  ]
